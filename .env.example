# Backend environment variables
NODE_ENV=development
PORT=5000

# Used to build absolute /uploads URLs returned to the frontend
BACKEND_URL=http://localhost:5000

# MongoDB
MONGODB_URI="mongodb://localhost:27017/velus_fashtown"

# Auth
JWT_SECRET="change_this_secret"

# Admin credentials (will be created on first run if not exists)
ADMIN_EMAIL="admin@velusfashtown.com"
ADMIN_PASSWORD="change_this_password"

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=

